# SQLite works out of the box. For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/salesgenie
DATABASE_URL=sqlite:///./salesgenie.db

# LLM provider: gemini | openai | none  (none = rule-based insights only)
LLM_PROVIDER=gemini
GEMINI_API_KEY=GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15

API_URL=http://localhost:8000
